@{
    Layout = "_Layout";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h3 class="card-title mb-3">Secret Trigger Recorder</h3>

        <div class="row g-3 align-items-center mb-3">
            <div class="col-md-6">
                <label class="form-label">Secret trigger word</label>
                <input id="triggerInput" class="form-control" placeholder="Enter trigger word (e.g., 'hello Lila')" maxlength="50" />
                <div id="triggerHelp" class="form-text">Stored locally in your browser session.</div>
            </div>

            <div class="col-auto">
                <label class="form-label d-block">&nbsp;</label>
                <button id="saveTriggerBtn" class="btn btn-primary">Save trigger</button>
            </div>

            <div class="col-auto">
                <label class="form-label d-block">&nbsp;</label>
                <button id="toggleListenBtn" class="btn btn-outline-success">Start Listening</button>
            </div>
        </div>

        <div class="mb-3">
            <span id="listeningStatus" class="me-3">
                <span class="bi-mic-fill">🎤</span> Listening: <strong id="listeningText">stopped</strong>
            </span>
            <span id="recordingStatus" class="me-3">
                <span id="recordIndicator" style="display:none">🔴</span> Recording: <strong id="recordingText">idle</strong>
                <span id="countdown" class="ms-2"></span>
            </span>
            <div id="messages" class="mt-2 text-muted small"></div>
        </div>

        <hr />

        <h5>Saved Recordings</h5>
        <div id="recordingsList" class="list-group"></div>
    </div>
</div>

<!-- small inline icons support -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
