@{
    Layout = "_Layout";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h3 class="card-title mb-3">Secret Trigger Recorder</h3>

        <!-- Trigger Management -->
        <div class="row g-3 align-items-center mb-3">
            <div class="col-md-6">
                <label for="triggerInput" class="form-label">Add text trigger</label>
                <input id="triggerInput" class="form-control" placeholder="e.g., 'help me lila'" maxlength="50" />
                <div id="triggerHelp" class="form-text">Triggers are stored locally in your browser.</div>
            </div>
            <div class="col-auto">
                <label class="form-label d-block">&nbsp;</label>
                <button id="addTextTriggerBtn" class="btn btn-primary">Save Trigger</button>
            </div>
            <div class="col-auto">
                <label class="form-label d-block">&nbsp;</label>
                <button id="recordTriggerBtn" class="btn btn-info"><span class="bi-mic-fill"></span> Hold to Record Trigger</button>
            </div>
        </div>

        <!-- Display Saved Triggers -->
        <div class="mb-3">
            <h6>Your Custom Triggers</h6>
            <div id="triggersList" class="list-group list-group-flush">
                <!-- Triggers will be rendered here by JS -->
            </div>
        </div>

        <hr />

        <!-- Status Indicators -->
        <div class="mb-3">
            <span id="listeningStatus" class="me-3">
                <span class="bi-mic-fill">🎤</span> Listening: <strong id="listeningText">initializing...</strong>
            </span>
            <span id="recordingStatus" class="me-3">
                <span id="recordIndicator" style="display:none">🔴</span> Recording: <strong id="recordingText">idle</strong>
                <span id="countdown" class="ms-2"></span>
            </span>
            <div id="messages" class="mt-2 text-muted small"></div>
        </div>

        <hr />

        <h5>Saved Recordings</h5>
        <div id="recordingsList" class="list-group"></div>
    </div>
</div>

<!-- small inline icons support -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">